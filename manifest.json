{
  "name": "navidrome-automatic-rating-plugin",
  "author": "navidrome-automatic-rating-plugin contributors",
  "version": "0.5.1",
  "description": "Generate per-user album and artist ratings independently from user-rated songs.",
  "website": "https://github.com/JLS1996/navidrome-automatic-rating-plugin",
  "permissions": {
    "subsonicapi": {
      "reason": "Read song ratings and update only album and artist ratings for assigned users."
    },
    "users": {
      "reason": "Calculate ratings separately for assigned users."
    },
    "library": {
      "reason": "Restrict scans to explicitly granted libraries, intersected with each user's access.",
      "filesystem": false
    },
    "scheduler": {
      "reason": "Run daily and serialize bounded continuation callbacks."
    },
    "kvstore": {
      "reason": "Persist source snapshots, checkpoints, summaries, and rating ownership with write intents.",
      "maxSize": "64MB"
    }
  },
  "config": {
    "schema": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "rate_albums": {
          "type": "boolean",
          "title": "Generate album ratings",
          "default": true,
          "description": "On: calculate each album from its own song ratings, including all discs."
        },
        "skip_unrated_users": {
          "type": "boolean",
          "title": "Skip users with nothing to update",
          "default": true,
          "description": "On: try a validated shortcut for users with no song ratings."
        },
        "audit_logging": {
          "type": "boolean",
          "title": "Include source evidence in logs",
          "default": false,
          "description": "On: include source evidence for troubleshooting or independent calculation checks."
        },
        "rate_artists": {
          "type": "boolean",
          "title": "Generate artist ratings",
          "default": true,
          "description": "On: calculate each artist from attributed song ratings across the granted libraries."
        },
        "artist_attribution": {
          "type": "string",
          "title": "Which artists receive each song?",
          "default": "album_artist",
          "description": "Choose which credited artists receive each song when calculating artist ratings.",
          "oneOf": [
            {
              "const": "album_artist",
              "title": "Album artists"
            },
            {
              "const": "performing_artist",
              "title": "Performing artists (including guests)"
            }
          ]
        },
        "album_rating_policy": {
          "type": "string",
          "title": "Existing ratings",
          "default": "preserve",
          "description": "Choose how this plugin treats existing album ratings.",
          "oneOf": [
            {
              "const": "preserve",
              "title": "Preserve manual ratings"
            },
            {
              "const": "replace",
              "title": "Replace existing ratings"
            }
          ]
        },
        "artist_rating_policy": {
          "type": "string",
          "title": "Existing ratings",
          "default": "preserve",
          "description": "Choose how this plugin treats existing artist ratings.",
          "oneOf": [
            {
              "const": "preserve",
              "title": "Preserve manual ratings"
            },
            {
              "const": "replace",
              "title": "Replace existing ratings"
            }
          ]
        },
        "dry_run": {
          "type": "boolean",
          "title": "Preview only — do not change ratings",
          "default": true,
          "description": "On: calculate proposed ratings and report them in the Navidrome logs without changing ratings."
        },
        "album_clear_below_threshold": {
          "type": "boolean",
          "title": "Clear album rating when coverage is too low",
          "default": true,
          "description": "On: clear an eligible album rating to 0 (unrated) when either coverage limit is not met."
        },
        "album_minimum_rated_percent": {
          "type": "integer",
          "title": "Minimum rated songs (%)",
          "default": 30,
          "minimum": 0,
          "maximum": 100,
          "description": "Required percentage of eligible songs with a contributing rating (0–100)."
        },
        "album_minimum_rated_songs": {
          "type": "integer",
          "title": "Minimum rated songs (count)",
          "default": 1,
          "minimum": 1,
          "maximum": 1000000,
          "description": "Required number of rated songs with positive weight (1–1,000,000)."
        },
        "album_one_star_weight": {
          "type": "number",
          "title": "1-star songs",
          "default": 1,
          "minimum": 0,
          "maximum": 10,
          "description": "Influence of 1-star songs: 0–10, including decimals. Set 0 to exclude this tier."
        },
        "album_two_star_weight": {
          "type": "number",
          "title": "2-star songs",
          "default": 2,
          "minimum": 0,
          "maximum": 10,
          "description": "Influence of 2-star songs: 0–10, including decimals. Set 0 to exclude this tier."
        },
        "album_three_star_weight": {
          "type": "number",
          "title": "3-star songs",
          "default": 3,
          "minimum": 0,
          "maximum": 10,
          "description": "Influence of 3-star songs: 0–10, including decimals. Set 0 to exclude this tier."
        },
        "album_four_star_weight": {
          "type": "number",
          "title": "4-star songs",
          "default": 4,
          "minimum": 0,
          "maximum": 10,
          "description": "Influence of 4-star songs: 0–10, including decimals. Set 0 to exclude this tier."
        },
        "album_five_star_weight": {
          "type": "number",
          "title": "5-star songs",
          "default": 5,
          "minimum": 0,
          "maximum": 10,
          "description": "Influence of 5-star songs: 0–10, including decimals. Set 0 to exclude this tier."
        },
        "artist_clear_below_threshold": {
          "type": "boolean",
          "title": "Clear artist rating when coverage is too low",
          "default": true,
          "description": "On: clear an eligible artist rating to 0 (unrated) when either coverage limit is not met."
        },
        "artist_minimum_rated_percent": {
          "type": "integer",
          "title": "Minimum rated songs (%)",
          "default": 30,
          "minimum": 0,
          "maximum": 100,
          "description": "Required percentage of eligible songs with a contributing rating (0–100)."
        },
        "artist_minimum_rated_songs": {
          "type": "integer",
          "title": "Minimum rated songs (count)",
          "default": 1,
          "minimum": 1,
          "maximum": 1000000,
          "description": "Required number of rated songs with positive weight (1–1,000,000)."
        },
        "artist_one_star_weight": {
          "type": "number",
          "title": "1-star songs",
          "default": 1,
          "minimum": 0,
          "maximum": 10,
          "description": "Influence of 1-star songs: 0–10, including decimals. Set 0 to exclude this tier."
        },
        "artist_two_star_weight": {
          "type": "number",
          "title": "2-star songs",
          "default": 2,
          "minimum": 0,
          "maximum": 10,
          "description": "Influence of 2-star songs: 0–10, including decimals. Set 0 to exclude this tier."
        },
        "artist_three_star_weight": {
          "type": "number",
          "title": "3-star songs",
          "default": 3,
          "minimum": 0,
          "maximum": 10,
          "description": "Influence of 3-star songs: 0–10, including decimals. Set 0 to exclude this tier."
        },
        "artist_four_star_weight": {
          "type": "number",
          "title": "4-star songs",
          "default": 4,
          "minimum": 0,
          "maximum": 10,
          "description": "Influence of 4-star songs: 0–10, including decimals. Set 0 to exclude this tier."
        },
        "artist_five_star_weight": {
          "type": "number",
          "title": "5-star songs",
          "default": 5,
          "minimum": 0,
          "maximum": 10,
          "description": "Influence of 5-star songs: 0–10, including decimals. Set 0 to exclude this tier."
        },
        "run_time_utc": {
          "type": "string",
          "title": "Daily start time (UTC)",
          "default": "03:00",
          "pattern": "^(?:[01]\\d|2[0-3]):[0-5]\\d$",
          "description": "Daily start time in 24-hour UTC, written as HH:MM."
        },
        "run_now": {
          "type": "boolean",
          "title": "Toggle to request a scan",
          "default": false,
          "description": "Flip this switch in either direction and save to request one scan."
        },
        "batch_size": {
          "type": "integer",
          "title": "Work units per checkpoint",
          "default": 25,
          "minimum": 1,
          "maximum": 100,
          "description": "Work units processed between saved checkpoints (1–100; default 25)."
        },
        "batch_interval_seconds": {
          "type": "integer",
          "title": "Pause between worker callbacks (seconds)",
          "default": 10,
          "minimum": 5,
          "maximum": 300,
          "description": "Seconds between worker callbacks (5–300; default 10)."
        },
        "detail_logging": {
          "type": "string",
          "title": "Per-item log detail",
          "default": "debug",
          "description": "Choose where individual album and artist decisions are logged.",
          "oneOf": [
            {
              "const": "debug",
              "title": "Debug (server debug logging required)"
            },
            {
              "const": "info",
              "title": "Info (every item)"
            },
            {
              "const": "off",
              "title": "Off (summaries and errors only)"
            }
          ]
        }
      },
      "allOf": [
        {
          "anyOf": [
            {
              "properties": {
                "album_one_star_weight": {
                  "exclusiveMinimum": 0
                }
              }
            },
            {
              "properties": {
                "album_two_star_weight": {
                  "exclusiveMinimum": 0
                }
              }
            },
            {
              "properties": {
                "album_three_star_weight": {
                  "exclusiveMinimum": 0
                }
              }
            },
            {
              "properties": {
                "album_four_star_weight": {
                  "exclusiveMinimum": 0
                }
              }
            },
            {
              "properties": {
                "album_five_star_weight": {
                  "exclusiveMinimum": 0
                }
              }
            }
          ]
        },
        {
          "anyOf": [
            {
              "properties": {
                "artist_one_star_weight": {
                  "exclusiveMinimum": 0
                }
              }
            },
            {
              "properties": {
                "artist_two_star_weight": {
                  "exclusiveMinimum": 0
                }
              }
            },
            {
              "properties": {
                "artist_three_star_weight": {
                  "exclusiveMinimum": 0
                }
              }
            },
            {
              "properties": {
                "artist_four_star_weight": {
                  "exclusiveMinimum": 0
                }
              }
            },
            {
              "properties": {
                "artist_five_star_weight": {
                  "exclusiveMinimum": 0
                }
              }
            }
          ]
        }
      ]
    },
    "uiSchema": {
      "type": "Categorization",
      "elements": [
        {
          "type": "Category",
          "label": "General",
          "elements": [
            {
              "type": "Group",
              "label": "Preview only",
              "elements": [
                {
                  "type": "VerticalLayout",
                  "elements": [
                    {
                      "type": "Control",
                      "scope": "#/properties/dry_run"
                    },
                    {
                      "type": "Label",
                      "text": "On: calculate proposed ratings and report them in the Navidrome logs without changing ratings."
                    },
                    {
                      "type": "Label",
                      "text": "\u00a0"
                    },
                    {
                      "type": "Label",
                      "text": "Off: apply eligible album and artist rating changes, including clears allowed by your policies."
                    },
                    {
                      "type": "Label",
                      "text": "\u00a0"
                    },
                    {
                      "type": "Label",
                      "text": "Review user_summary and run_summary in the logs first. Song ratings and music files are never changed."
                    }
                  ]
                }
              ]
            },
            {
              "type": "Group",
              "label": "Request a scan",
              "elements": [
                {
                  "type": "VerticalLayout",
                  "elements": [
                    {
                      "type": "Control",
                      "scope": "#/properties/run_now"
                    },
                    {
                      "type": "Label",
                      "text": "Flip this switch in either direction and save to request one scan."
                    },
                    {
                      "type": "Label",
                      "text": "\u00a0"
                    },
                    {
                      "type": "Label",
                      "text": "A scan starts on the next worker tick, normally within 10 seconds. No reset or Navidrome restart is needed."
                    },
                    {
                      "type": "Label",
                      "text": "\u00a0"
                    },
                    {
                      "type": "Label",
                      "text": "Saving the same position does not request another scan. A request during an active scan joins that scan."
                    }
                  ]
                }
              ]
            },
            {
              "type": "Group",
              "label": "When to run",
              "elements": [
                {
                  "type": "VerticalLayout",
                  "elements": [
                    {
                      "type": "Control",
                      "scope": "#/properties/run_time_utc"
                    },
                    {
                      "type": "Label",
                      "text": "For example, 03:00 means 03:00 UTC every day. Convert from your local time; UTC does not follow daylight saving time."
                    },
                    {
                      "type": "Label",
                      "text": "\u00a0"
                    },
                    {
                      "type": "Label",
                      "text": "Saving a new time updates the daily schedule. A daily run missed while the server is offline is not replayed."
                    }
                  ]
                }
              ]
            },
            {
              "type": "Group",
              "label": "Artist credits",
              "elements": [
                {
                  "type": "VerticalLayout",
                  "elements": [
                    {
                      "type": "Control",
                      "scope": "#/properties/artist_attribution"
                    },
                    {
                      "type": "Label",
                      "text": "Album artists: use the album credits. Every song on an album contributes to each credited album artist."
                    },
                    {
                      "type": "Label",
                      "text": "\u00a0"
                    },
                    {
                      "type": "Label",
                      "text": "Performing artists: use each song’s performer credits, including guests. A song contributes once to each credited artist."
                    },
                    {
                      "type": "Label",
                      "text": "\u00a0"
                    },
                    {
                      "type": "Label",
                      "text": "Artist ratings use song ratings directly, independently of album ratings. This choice has no effect when artist output is off."
                    }
                  ]
                }
              ]
            }
          ]
        },
        {
          "type": "Category",
          "label": "Albums",
          "elements": [
            {
              "type": "Group",
              "label": "Album output",
              "elements": [
                {
                  "type": "VerticalLayout",
                  "elements": [
                    {
                      "type": "Control",
                      "scope": "#/properties/rate_albums"
                    },
                    {
                      "type": "Label",
                      "text": "On: calculate each album from its own song ratings, including all discs."
                    },
                    {
                      "type": "Label",
                      "text": "\u00a0"
                    },
                    {
                      "type": "Label",
                      "text": "Off: leave existing album ratings in place and stop updating this output."
                    },
                    {
                      "type": "Label",
                      "text": "\u00a0"
                    },
                    {
                      "type": "Label",
                      "text": "This output has its own coverage, weights, and existing-rating policy."
                    }
                  ]
                }
              ]
            },
            {
              "type": "Group",
              "label": "Existing ratings",
              "elements": [
                {
                  "type": "VerticalLayout",
                  "elements": [
                    {
                      "type": "Control",
                      "scope": "#/properties/album_rating_policy"
                    },
                    {
                      "type": "Label",
                      "text": "Preserve: protect pre-existing ratings and detected manual edits, including manual clears. Ratings managed by this plugin keep updating."
                    },
                    {
                      "type": "Label",
                      "text": "\u00a0"
                    },
                    {
                      "type": "Label",
                      "text": "Replace: allow overwriting manual ratings and ratings from other plugins. Matching calculated values are adopted without rewriting them."
                    },
                    {
                      "type": "Label",
                      "text": "\u00a0"
                    },
                    {
                      "type": "Label",
                      "text": "For a one-time migration, use Replace for one scan, then return to Preserve if you want later manual edits protected."
                    }
                  ]
                }
              ]
            },
            {
              "type": "Group",
              "label": "Coverage required",
              "elements": [
                {
                  "type": "VerticalLayout",
                  "elements": [
                    {
                      "type": "Control",
                      "scope": "#/properties/album_minimum_rated_percent"
                    },
                    {
                      "type": "Label",
                      "text": "For example, 30% of 12 eligible songs requires 4 rated songs. The minimum count below must also be met."
                    },
                    {
                      "type": "Label",
                      "text": "\u00a0"
                    },
                    {
                      "type": "Label",
                      "text": "Unrated songs count toward eligible songs. Rated songs with a zero weight are excluded from both scoring and coverage."
                    },
                    {
                      "type": "Label",
                      "text": "\u00a0"
                    },
                    {
                      "type": "Control",
                      "scope": "#/properties/album_minimum_rated_songs"
                    },
                    {
                      "type": "Label",
                      "text": "Both limits apply: the plugin uses the larger of this count and the count required by the percentage."
                    },
                    {
                      "type": "Label",
                      "text": "\u00a0"
                    },
                    {
                      "type": "Label",
                      "text": "A percentage of 0 still requires this minimum number of contributing ratings."
                    },
                    {
                      "type": "Label",
                      "text": "\u00a0"
                    },
                    {
                      "type": "Control",
                      "scope": "#/properties/album_clear_below_threshold"
                    },
                    {
                      "type": "Label",
                      "text": "On: clear an eligible album rating to 0 (unrated) when either coverage limit is not met."
                    },
                    {
                      "type": "Label",
                      "text": "\u00a0"
                    },
                    {
                      "type": "Label",
                      "text": "Off: retain the previous rating below coverage. Preserve mode still protects unmanaged ratings and detected manual edits."
                    },
                    {
                      "type": "Label",
                      "text": "\u00a0"
                    },
                    {
                      "type": "Label",
                      "text": "Missing or incomplete sources never trigger a clear. If every rated song is excluded by zero weights, the current rating is retained."
                    }
                  ]
                }
              ]
            },
            {
              "type": "Group",
              "label": "Song weights",
              "elements": [
                {
                  "type": "VerticalLayout",
                  "elements": [
                    {
                      "type": "Label",
                      "text": "Higher weights give that star level more influence in the average."
                    },
                    {
                      "type": "Label",
                      "text": "\u00a0"
                    },
                    {
                      "type": "Label",
                      "text": "Use 1 for every tier for a simple average. The defaults 1, 2, 3, 4, 5 favor higher-rated songs."
                    },
                    {
                      "type": "Label",
                      "text": "\u00a0"
                    },
                    {
                      "type": "Control",
                      "scope": "#/properties/album_one_star_weight"
                    },
                    {
                      "type": "Control",
                      "scope": "#/properties/album_two_star_weight"
                    },
                    {
                      "type": "Control",
                      "scope": "#/properties/album_three_star_weight"
                    },
                    {
                      "type": "Control",
                      "scope": "#/properties/album_four_star_weight"
                    },
                    {
                      "type": "Control",
                      "scope": "#/properties/album_five_star_weight"
                    },
                    {
                      "type": "Label",
                      "text": "A weight of 0 excludes those songs from both scoring and coverage. Keep at least one weight positive."
                    },
                    {
                      "type": "Label",
                      "text": "\u00a0"
                    },
                    {
                      "type": "Label",
                      "text": "The result rounds to the nearest star, with halves rounded up: 2.5 becomes 3."
                    }
                  ]
                }
              ]
            }
          ]
        },
        {
          "type": "Category",
          "label": "Artists",
          "elements": [
            {
              "type": "Group",
              "label": "Artist output",
              "elements": [
                {
                  "type": "VerticalLayout",
                  "elements": [
                    {
                      "type": "Control",
                      "scope": "#/properties/rate_artists"
                    },
                    {
                      "type": "Label",
                      "text": "On: calculate each artist from attributed song ratings across the granted libraries."
                    },
                    {
                      "type": "Label",
                      "text": "\u00a0"
                    },
                    {
                      "type": "Label",
                      "text": "Off: leave existing artist ratings in place and stop updating this output."
                    },
                    {
                      "type": "Label",
                      "text": "\u00a0"
                    },
                    {
                      "type": "Label",
                      "text": "This output has its own coverage, weights, and existing-rating policy."
                    }
                  ]
                }
              ]
            },
            {
              "type": "Group",
              "label": "Existing ratings",
              "elements": [
                {
                  "type": "VerticalLayout",
                  "elements": [
                    {
                      "type": "Control",
                      "scope": "#/properties/artist_rating_policy"
                    },
                    {
                      "type": "Label",
                      "text": "Preserve: protect pre-existing ratings and detected manual edits, including manual clears. Ratings managed by this plugin keep updating."
                    },
                    {
                      "type": "Label",
                      "text": "\u00a0"
                    },
                    {
                      "type": "Label",
                      "text": "Replace: allow overwriting manual ratings and ratings from other plugins. Matching calculated values are adopted without rewriting them."
                    },
                    {
                      "type": "Label",
                      "text": "\u00a0"
                    },
                    {
                      "type": "Label",
                      "text": "For a one-time migration, use Replace for one scan, then return to Preserve if you want later manual edits protected."
                    }
                  ]
                }
              ]
            },
            {
              "type": "Group",
              "label": "Coverage required",
              "elements": [
                {
                  "type": "VerticalLayout",
                  "elements": [
                    {
                      "type": "Control",
                      "scope": "#/properties/artist_minimum_rated_percent"
                    },
                    {
                      "type": "Label",
                      "text": "For example, 30% of 12 eligible songs requires 4 rated songs. The minimum count below must also be met."
                    },
                    {
                      "type": "Label",
                      "text": "\u00a0"
                    },
                    {
                      "type": "Label",
                      "text": "Unrated songs count toward eligible songs. Rated songs with a zero weight are excluded from both scoring and coverage."
                    },
                    {
                      "type": "Label",
                      "text": "\u00a0"
                    },
                    {
                      "type": "Control",
                      "scope": "#/properties/artist_minimum_rated_songs"
                    },
                    {
                      "type": "Label",
                      "text": "Both limits apply: the plugin uses the larger of this count and the count required by the percentage."
                    },
                    {
                      "type": "Label",
                      "text": "\u00a0"
                    },
                    {
                      "type": "Label",
                      "text": "A percentage of 0 still requires this minimum number of contributing ratings."
                    },
                    {
                      "type": "Label",
                      "text": "\u00a0"
                    },
                    {
                      "type": "Control",
                      "scope": "#/properties/artist_clear_below_threshold"
                    },
                    {
                      "type": "Label",
                      "text": "On: clear an eligible artist rating to 0 (unrated) when either coverage limit is not met."
                    },
                    {
                      "type": "Label",
                      "text": "\u00a0"
                    },
                    {
                      "type": "Label",
                      "text": "Off: retain the previous rating below coverage. Preserve mode still protects unmanaged ratings and detected manual edits."
                    },
                    {
                      "type": "Label",
                      "text": "\u00a0"
                    },
                    {
                      "type": "Label",
                      "text": "Missing or incomplete sources never trigger a clear. If every rated song is excluded by zero weights, the current rating is retained."
                    }
                  ]
                }
              ]
            },
            {
              "type": "Group",
              "label": "Song weights",
              "elements": [
                {
                  "type": "VerticalLayout",
                  "elements": [
                    {
                      "type": "Label",
                      "text": "Higher weights give that star level more influence in the average."
                    },
                    {
                      "type": "Label",
                      "text": "\u00a0"
                    },
                    {
                      "type": "Label",
                      "text": "Use 1 for every tier for a simple average. The defaults 1, 2, 3, 4, 5 favor higher-rated songs."
                    },
                    {
                      "type": "Label",
                      "text": "\u00a0"
                    },
                    {
                      "type": "Control",
                      "scope": "#/properties/artist_one_star_weight"
                    },
                    {
                      "type": "Control",
                      "scope": "#/properties/artist_two_star_weight"
                    },
                    {
                      "type": "Control",
                      "scope": "#/properties/artist_three_star_weight"
                    },
                    {
                      "type": "Control",
                      "scope": "#/properties/artist_four_star_weight"
                    },
                    {
                      "type": "Control",
                      "scope": "#/properties/artist_five_star_weight"
                    },
                    {
                      "type": "Label",
                      "text": "A weight of 0 excludes those songs from both scoring and coverage. Keep at least one weight positive."
                    },
                    {
                      "type": "Label",
                      "text": "\u00a0"
                    },
                    {
                      "type": "Label",
                      "text": "The result rounds to the nearest star, with halves rounded up: 2.5 becomes 3."
                    }
                  ]
                }
              ]
            }
          ]
        },
        {
          "type": "Category",
          "label": "Extra",
          "elements": [
            {
              "type": "Group",
              "label": "Performance",
              "elements": [
                {
                  "type": "VerticalLayout",
                  "elements": [
                    {
                      "type": "Control",
                      "scope": "#/properties/batch_size"
                    },
                    {
                      "type": "Label",
                      "text": "Lower values save progress more often. Higher values reduce checkpoint overhead but can repeat more work after an interruption."
                    },
                    {
                      "type": "Label",
                      "text": "\u00a0"
                    },
                    {
                      "type": "Label",
                      "text": "Batches share a 20-second worker-callback budget. Usually leave this at 25."
                    },
                    {
                      "type": "Label",
                      "text": "\u00a0"
                    },
                    {
                      "type": "Control",
                      "scope": "#/properties/batch_interval_seconds"
                    },
                    {
                      "type": "Label",
                      "text": "Higher values reduce background activity but delay scan continuations and manual requests."
                    },
                    {
                      "type": "Label",
                      "text": "\u00a0"
                    },
                    {
                      "type": "Label",
                      "text": "Batches within one callback do not pause. Usually leave this at 10 seconds."
                    },
                    {
                      "type": "Label",
                      "text": "\u00a0"
                    },
                    {
                      "type": "Control",
                      "scope": "#/properties/skip_unrated_users"
                    },
                    {
                      "type": "Label",
                      "text": "On: try a validated shortcut for users with no song ratings."
                    },
                    {
                      "type": "Label",
                      "text": "\u00a0"
                    },
                    {
                      "type": "Label",
                      "text": "Ownership history, possible clears, or uncertain source data force a full scan. This setting does not bypass required updates."
                    },
                    {
                      "type": "Label",
                      "text": "\u00a0"
                    },
                    {
                      "type": "Label",
                      "text": "Off: evaluate every album and artist, including users with no rated songs."
                    }
                  ]
                }
              ]
            },
            {
              "type": "Group",
              "label": "Logs and troubleshooting",
              "elements": [
                {
                  "type": "VerticalLayout",
                  "elements": [
                    {
                      "type": "Control",
                      "scope": "#/properties/detail_logging"
                    },
                    {
                      "type": "Label",
                      "text": "Debug: item details appear only when Navidrome debug logging is enabled."
                    },
                    {
                      "type": "Label",
                      "text": "\u00a0"
                    },
                    {
                      "type": "Label",
                      "text": "Info: show every item at info level. Off: hide routine item details."
                    },
                    {
                      "type": "Label",
                      "text": "\u00a0"
                    },
                    {
                      "type": "Label",
                      "text": "Run summaries and errors remain visible with every choice. Info can produce large logs."
                    },
                    {
                      "type": "Label",
                      "text": "\u00a0"
                    },
                    {
                      "type": "Control",
                      "scope": "#/properties/audit_logging"
                    },
                    {
                      "type": "Label",
                      "text": "On: include source evidence for troubleshooting or independent calculation checks."
                    },
                    {
                      "type": "Label",
                      "text": "\u00a0"
                    },
                    {
                      "type": "Label",
                      "text": "Records song IDs, ratings, artist credits, and settings. Forces full scans and can greatly increase runtime and log volume."
                    },
                    {
                      "type": "Label",
                      "text": "\u00a0"
                    },
                    {
                      "type": "Label",
                      "text": "These logs contain private library data. Usually leave this off; turn it on temporarily when diagnosing a calculation."
                    }
                  ]
                }
              ]
            }
          ]
        }
      ]
    }
