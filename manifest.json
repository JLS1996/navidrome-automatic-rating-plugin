{
  "name": "Automatic Ratings",
  "author": "Automatic Ratings contributors",
  "version": "0.3.1",
  "description": "Generate per-user album and artist ratings independently from user-rated songs.",
  "website": "https://github.com/JLS1996/navidrome-automatic-rating-plugin",
  "permissions": {
    "subsonicapi": {
      "reason": "Read song ratings and update only album and artist ratings for assigned users."
    },
    "users": {
      "reason": "Calculate ratings separately for assigned users."
    },
    "library": {
      "reason": "Restrict scans to explicitly granted libraries, intersected with each user's access.",
      "filesystem": false
    },
    "scheduler": {
      "reason": "Run daily and serialize bounded continuation callbacks."
    },
    "kvstore": {
      "reason": "Persist source snapshots, checkpoints, summaries, and rating ownership with write intents.",
      "maxSize": "64MB"
    }
  },
  "config": {
    "schema": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "rate_albums": {
          "type": "boolean",
          "title": "Generate album ratings",
          "default": true,
          "description": "Calculate each album from your song ratings on that album."
        },
        "skip_unrated_users": {
          "type": "boolean",
          "title": "Skip users with nothing to update",
          "default": true,
          "description": "Speeds up scans for users with no song ratings. Falls back to a full scan whenever changes may be needed."
        },
        "audit_logging": {
          "type": "boolean",
          "title": "Include source evidence in logs",
          "default": false,
          "description": "For troubleshooting or independent verification. Logs song IDs, ratings, artist credits, and settings; forces a full scan and can produce large, private logs."
        },
        "rate_artists": {
          "type": "boolean",
          "title": "Generate artist ratings",
          "default": true,
          "description": "Calculate each artist directly from your song ratings, independently of album ratings."
        },
        "artist_attribution": {
          "type": "string",
          "title": "Which artists receive each song?",
          "default": "album_artist",
          "description": "Album artists uses the album credits; performing artists uses each song’s credits, including guests. A song counts once per credited artist.",
          "oneOf": [
            {
              "const": "album_artist",
              "title": "Album artists"
            },
            {
              "const": "performing_artist",
              "title": "Performing artists (including guests)"
            }
          ]
        },
        "album_rating_policy": {
          "type": "string",
          "title": "Existing ratings",
          "default": "preserve",
          "description": "Preserve keeps ratings set by you or another plugin, including detected manual edits. Replace may overwrite them and take over matching ratings.",
          "oneOf": [
            {
              "const": "preserve",
              "title": "Preserve manual ratings"
            },
            {
              "const": "replace",
              "title": "Replace existing ratings"
            }
          ]
        },
        "artist_rating_policy": {
          "type": "string",
          "title": "Existing ratings",
          "default": "preserve",
          "description": "Preserve keeps ratings set by you or another plugin, including detected manual edits. Replace may overwrite them and take over matching ratings.",
          "oneOf": [
            {
              "const": "preserve",
              "title": "Preserve manual ratings"
            },
            {
              "const": "replace",
              "title": "Replace existing ratings"
            }
          ]
        },
        "dry_run": {
          "type": "boolean",
          "title": "Preview only — do not change ratings",
          "default": true,
          "description": "Leave on to review proposed changes in the Navidrome logs. Turn off to apply them on the next run."
        },
        "album_clear_below_threshold": {
          "type": "boolean",
          "title": "Clear album rating when coverage is too low",
          "default": true,
          "description": "Turn off to keep the last rating below either coverage limit. Preserve still protects manual ratings. Empty sources and sources with every rated song excluded are never cleared."
        },
        "album_minimum_rated_percent": {
          "type": "integer",
          "title": "Minimum rated songs (%)",
          "default": 30,
          "minimum": 0,
          "maximum": 100,
          "description": "Both coverage limits must be met. For example, 30% of 12 eligible songs requires 4 rated songs. Unrated songs count toward the total; zero-weight songs do not."
        },
        "album_minimum_rated_songs": {
          "type": "integer",
          "title": "Minimum rated songs (count)",
          "default": 1,
          "minimum": 1,
          "maximum": 1000000,
          "description": "Require at least this many rated songs with positive weight, as well as the percentage above."
        },
        "album_one_star_weight": {
          "type": "number",
          "title": "1-star songs",
          "default": 1,
          "minimum": 0,
          "maximum": 10,
          "description": "0 excludes this star level from scoring and coverage."
        },
        "album_two_star_weight": {
          "type": "number",
          "title": "2-star songs",
          "default": 2,
          "minimum": 0,
          "maximum": 10
        },
        "album_three_star_weight": {
          "type": "number",
          "title": "3-star songs",
          "default": 3,
          "minimum": 0,
          "maximum": 10
        },
        "album_four_star_weight": {
          "type": "number",
          "title": "4-star songs",
          "default": 4,
          "minimum": 0,
          "maximum": 10
        },
        "album_five_star_weight": {
          "type": "number",
          "title": "5-star songs",
          "default": 5,
          "minimum": 0,
          "maximum": 10
        },
        "artist_clear_below_threshold": {
          "type": "boolean",
          "title": "Clear artist rating when coverage is too low",
          "default": true,
          "description": "Turn off to keep the last rating below either coverage limit. Preserve still protects manual ratings. Empty sources and sources with every rated song excluded are never cleared."
        },
        "artist_minimum_rated_percent": {
          "type": "integer",
          "title": "Minimum rated songs (%)",
          "default": 30,
          "minimum": 0,
          "maximum": 100,
          "description": "Both coverage limits must be met. For example, 30% of 12 eligible songs requires 4 rated songs. Unrated songs count toward the total; zero-weight songs do not."
        },
        "artist_minimum_rated_songs": {
          "type": "integer",
          "title": "Minimum rated songs (count)",
          "default": 1,
          "minimum": 1,
          "maximum": 1000000,
          "description": "Require at least this many rated songs with positive weight, as well as the percentage above."
        },
        "artist_one_star_weight": {
          "type": "number",
          "title": "1-star songs",
          "default": 1,
          "minimum": 0,
          "maximum": 10,
          "description": "0 excludes this star level from scoring and coverage."
        },
        "artist_two_star_weight": {
          "type": "number",
          "title": "2-star songs",
          "default": 2,
          "minimum": 0,
          "maximum": 10
        },
        "artist_three_star_weight": {
          "type": "number",
          "title": "3-star songs",
          "default": 3,
          "minimum": 0,
          "maximum": 10
        },
        "artist_four_star_weight": {
          "type": "number",
          "title": "4-star songs",
          "default": 4,
          "minimum": 0,
          "maximum": 10
        },
        "artist_five_star_weight": {
          "type": "number",
          "title": "5-star songs",
          "default": 5,
          "minimum": 0,
          "maximum": 10
        },
        "run_time_utc": {
          "type": "string",
          "title": "Daily start time (UTC)",
          "default": "03:00",
          "pattern": "^(?:[01]\\d|2[0-3]):[0-5]\\d$",
          "description": "24-hour time, e.g. 03:00. UTC does not follow daylight saving time. Restart after saving settings on Navidrome 0.64.2."
        },
        "run_now": {
          "type": "boolean",
          "title": "Request one run",
          "default": false,
          "description": "Runs once on the next worker tick. To run again, save this off and let a worker tick observe it, then save it on. Restart after each save on Navidrome 0.64.2."
        },
        "batch_size": {
          "type": "integer",
          "title": "Work units per checkpoint",
          "default": 25,
          "minimum": 1,
          "maximum": 100,
          "description": "Usually leave at 25. Lower values save progress more often; higher values reduce storage overhead. Batches share a 20-second callback budget."
        },
        "batch_interval_seconds": {
          "type": "integer",
          "title": "Pause between worker callbacks (seconds)",
          "default": 10,
          "minimum": 5,
          "maximum": 300,
          "description": "Usually leave at 10. Higher values reduce background activity but delay continuations and manual requests. Batches within one callback do not pause."
        },
        "detail_logging": {
          "type": "string",
          "title": "Per-item log detail",
          "default": "debug",
          "description": "Summaries and errors are always logged. Use Info to see each result without enabling server debug logging; Off hides routine item details.",
          "oneOf": [
            {
              "const": "debug",
              "title": "Debug (server debug logging required)"
            },
            {
              "const": "info",
              "title": "Info (every item)"
            },
            {
              "const": "off",
              "title": "Off (summaries and errors only)"
            }
          ]
        }
      },
      "allOf": [
        {
          "anyOf": [
            {
              "properties": {
                "album_one_star_weight": {
                  "exclusiveMinimum": 0
                }
              }
            },
            {
              "properties": {
                "album_two_star_weight": {
                  "exclusiveMinimum": 0
                }
              }
            },
            {
              "properties": {
                "album_three_star_weight": {
                  "exclusiveMinimum": 0
                }
              }
            },
            {
              "properties": {
                "album_four_star_weight": {
                  "exclusiveMinimum": 0
                }
              }
            },
            {
              "properties": {
                "album_five_star_weight": {
                  "exclusiveMinimum": 0
                }
              }
            }
          ]
        },
        {
          "anyOf": [
            {
              "properties": {
                "artist_one_star_weight": {
                  "exclusiveMinimum": 0
                }
              }
            },
            {
              "properties": {
                "artist_two_star_weight": {
                  "exclusiveMinimum": 0
                }
              }
            },
            {
              "properties": {
                "artist_three_star_weight": {
                  "exclusiveMinimum": 0
                }
              }
            },
            {
              "properties": {
                "artist_four_star_weight": {
                  "exclusiveMinimum": 0
                }
              }
            },
            {
              "properties": {
                "artist_five_star_weight": {
                  "exclusiveMinimum": 0
                }
              }
            }
          ]
        }
      ]
    },
    "uiSchema": {
      "type": "Categorization",
      "elements": [
        {
          "type": "Category",
          "label": "Start here",
          "elements": [
            {
              "type": "Group",
              "label": "Preview before applying",
              "elements": [
                {
                  "type": "VerticalLayout",
                  "elements": [
                    {
                      "type": "Control",
                      "scope": "#/properties/dry_run"
                    },
                    {
                      "type": "Label",
                      "text": "Leave on to review proposed changes in the Navidrome logs. Turn off to apply them on the next run."
                    }
                  ]
                }
              ]
            },
            {
              "type": "Group",
              "label": "Album output",
              "elements": [
                {
                  "type": "VerticalLayout",
                  "elements": [
                    {
                      "type": "Control",
                      "scope": "#/properties/rate_albums"
                    },
                    {
                      "type": "Label",
                      "text": "Calculate each album from your song ratings on that album."
                    }
                  ]
                }
              ]
            },
            {
              "type": "Group",
              "label": "Artist output",
              "elements": [
                {
                  "type": "VerticalLayout",
                  "elements": [
                    {
                      "type": "Control",
                      "scope": "#/properties/rate_artists"
                    },
                    {
                      "type": "Label",
                      "text": "Calculate each artist directly from your song ratings, independently of album ratings."
                    }
                  ]
                }
              ]
            },
            {
              "type": "Group",
              "label": "Artist credits",
              "elements": [
                {
                  "type": "VerticalLayout",
                  "elements": [
                    {
                      "type": "Control",
                      "scope": "#/properties/artist_attribution"
                    }
                  ]
                }
              ]
            }
          ]
        },
        {
          "type": "Category",
          "label": "Album ratings",
          "elements": [
            {
              "type": "Group",
              "label": "Existing ratings",
              "elements": [
                {
                  "type": "VerticalLayout",
                  "elements": [
                    {
                      "type": "Control",
                      "scope": "#/properties/album_rating_policy"
                    }
                  ]
                }
              ]
            },
            {
              "type": "Group",
              "label": "Coverage required",
              "elements": [
                {
                  "type": "VerticalLayout",
                  "elements": [
                    {
                      "type": "Control",
                      "scope": "#/properties/album_minimum_rated_percent"
                    },
                    {
                      "type": "Control",
                      "scope": "#/properties/album_minimum_rated_songs"
                    },
                    {
                      "type": "Control",
                      "scope": "#/properties/album_clear_below_threshold"
                    },
                    {
                      "type": "Label",
                      "text": "Turn off to keep the last rating below either coverage limit. Preserve still protects manual ratings. Empty sources and sources with every rated song excluded are never cleared."
                    }
                  ]
                }
              ]
            },
            {
              "type": "Group",
              "label": "Song weights",
              "elements": [
                {
                  "type": "VerticalLayout",
                  "elements": [
                    {
                      "type": "Control",
                      "scope": "#/properties/album_one_star_weight"
                    },
                    {
                      "type": "Control",
                      "scope": "#/properties/album_two_star_weight"
                    },
                    {
                      "type": "Control",
                      "scope": "#/properties/album_three_star_weight"
                    },
                    {
                      "type": "Control",
                      "scope": "#/properties/album_four_star_weight"
                    },
                    {
                      "type": "Control",
                      "scope": "#/properties/album_five_star_weight"
                    },
                    {
                      "type": "Label",
                      "text": "Higher weights give those songs more influence. Use 1 for every level for a simple average; 0 excludes a level. Keep at least one weight positive. Results round to the nearest star, with halves rounded up."
                    }
                  ]
                }
              ]
            }
          ]
        },
        {
          "type": "Category",
          "label": "Artist ratings",
          "elements": [
            {
              "type": "Group",
              "label": "Existing ratings",
              "elements": [
                {
                  "type": "VerticalLayout",
                  "elements": [
                    {
                      "type": "Control",
                      "scope": "#/properties/artist_rating_policy"
                    }
                  ]
                }
              ]
            },
            {
              "type": "Group",
              "label": "Coverage required",
              "elements": [
                {
                  "type": "VerticalLayout",
                  "elements": [
                    {
                      "type": "Control",
                      "scope": "#/properties/artist_minimum_rated_percent"
                    },
                    {
                      "type": "Control",
                      "scope": "#/properties/artist_minimum_rated_songs"
                    },
                    {
                      "type": "Control",
                      "scope": "#/properties/artist_clear_below_threshold"
                    },
                    {
                      "type": "Label",
                      "text": "Turn off to keep the last rating below either coverage limit. Preserve still protects manual ratings. Empty sources and sources with every rated song excluded are never cleared."
                    }
                  ]
                }
              ]
            },
            {
              "type": "Group",
              "label": "Song weights",
              "elements": [
                {
                  "type": "VerticalLayout",
                  "elements": [
                    {
                      "type": "Control",
                      "scope": "#/properties/artist_one_star_weight"
                    },
                    {
                      "type": "Control",
                      "scope": "#/properties/artist_two_star_weight"
                    },
                    {
                      "type": "Control",
                      "scope": "#/properties/artist_three_star_weight"
                    },
                    {
                      "type": "Control",
                      "scope": "#/properties/artist_four_star_weight"
                    },
                    {
                      "type": "Control",
                      "scope": "#/properties/artist_five_star_weight"
                    },
                    {
                      "type": "Label",
                      "text": "Higher weights give those songs more influence. Use 1 for every level for a simple average; 0 excludes a level. Keep at least one weight positive. Results round to the nearest star, with halves rounded up."
                    }
                  ]
                }
              ]
            }
          ]
        },
        {
          "type": "Category",
          "label": "Schedule and logs",
          "elements": [
            {
              "type": "Group",
              "label": "When to run",
              "elements": [
                {
                  "type": "VerticalLayout",
                  "elements": [
                    {
                      "type": "Control",
                      "scope": "#/properties/run_time_utc"
                    },
                    {
                      "type": "Control",
                      "scope": "#/properties/run_now"
                    },
                    {
                      "type": "Label",
                      "text": "Runs once on the next worker tick. To run again, save this off and let a worker tick observe it, then save it on. Restart after each save on Navidrome 0.64.2."
                    }
                  ]
                }
              ]
            },
            {
              "type": "Group",
              "label": "Performance",
              "elements": [
                {
                  "type": "VerticalLayout",
                  "elements": [
                    {
                      "type": "Control",
                      "scope": "#/properties/batch_size"
                    },
                    {
                      "type": "Control",
                      "scope": "#/properties/batch_interval_seconds"
                    },
                    {
                      "type": "Control",
                      "scope": "#/properties/skip_unrated_users"
                    },
                    {
                      "type": "Label",
                      "text": "Speeds up scans for users with no song ratings. Falls back to a full scan whenever changes may be needed."
                    }
                  ]
                }
              ]
            },
            {
              "type": "Group",
              "label": "Logs and troubleshooting",
              "elements": [
                {
                  "type": "VerticalLayout",
                  "elements": [
                    {
                      "type": "Control",
                      "scope": "#/properties/detail_logging"
                    },
                    {
                      "type": "Control",
                      "scope": "#/properties/audit_logging"
                    },
                    {
                      "type": "Label",
                      "text": "For troubleshooting or independent verification. Logs song IDs, ratings, artist credits, and settings; forces a full scan and can produce large, private logs."
                    }
                  ]
                }
              ]
            }
          ]
        }
      ]
    }
  }
}
